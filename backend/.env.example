# Port for the Go HTTP API
PORT=8000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lightly?sslmode=disable

# Public Base URL for shortened links (e.g., https://light.ly or http://localhost:8000)
# If not set, it dynamically resolves from the incoming request's Host header.
BASE_URL=http://localhost:8000
